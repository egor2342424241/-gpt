<Window x:Class="WindowsAudioStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Audio Studio" Width="1180" Height="760"
        MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#F3F5F7" Foreground="#20242A">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="Windows Audio Studio" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="DeviceLabel" Text="Подключение к устройству вывода..." Foreground="#68717D" Margin="0,3,0,0"/>
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="Обновить" Padding="18,8" Click="Refresh_Click"/>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="ПРИЛОЖЕНИЯ" FontSize="12" FontWeight="Bold" Foreground="#68717D" Margin="2,2,0,10"/>
          <ListBox x:Name="SessionsList" ItemsSource="{Binding Sessions}" Background="Transparent" BorderThickness="0"
                   SelectionChanged="SessionsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#F6F7F9" CornerRadius="8" Padding="9" Margin="0,3">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="185"/>
                      <CheckBox DockPanel.Dock="Right" Content="DSP" IsChecked="{Binding IsProcessing, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ProcessName}" FontSize="10" Foreground="#78818D" Margin="0,2,0,5"/>
                    <DockPanel>
                      <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Width="190"/>
                      <TextBlock Text="{Binding VolumePercent, StringFormat={}{0}%}" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                    </DockPanel>
                    <DockPanel Margin="0,2,0,0">
                      <ProgressBar Height="4" Maximum="1" Value="{Binding Peak}" VerticalAlignment="Center" Width="180"/>
                      <CheckBox DockPanel.Dock="Right" Content="Mute" IsChecked="{Binding IsMuted, Mode=TwoWay}" FontSize="10"/>
                    </DockPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel>
                <StackPanel>
                  <TextBlock Text="20-полосный эквалайзер" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock x:Name="SelectedSessionLabel" Text="Выбери приложение слева" Foreground="#68717D" Margin="0,3,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Сбросить EQ" Padding="12,6" Click="ResetEq_Click" VerticalAlignment="Center"/>
              </DockPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <UniformGrid x:Name="EqGrid" Rows="1" Margin="0,15,0,0"/>
              </ScrollViewer>
              <TextBlock Text="Диапазон каждой полосы: −12…+12 dB" FontSize="10" Foreground="#78818D" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="White" CornerRadius="10" Padding="14">
            <StackPanel>
              <TextBlock Text="DSP-эффекты" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <WrapPanel>
                <CheckBox x:Name="BassBoostBox" Content="Bass Boost" Tag="BassBoost" Margin="0,0,20,10" Checked="EffectChanged" Unchecked="EffectChanged"/>
                <CheckBox x:Name="StereoWidthBox" Content="Stereo Width" Tag="StereoWidth" Margin="0,0,20,10" Checked="EffectChanged" Unchecked="EffectChanged"/>
                <CheckBox x:Name="ReverbBox" Content="Reverb" Tag="Reverb" Margin="0,0,20,10" Checked="EffectChanged" Unchecked="EffectChanged"/>
                <CheckBox x:Name="CompressorBox" Content="Compressor" Tag="Compressor" Margin="0,0,20,10" Checked="EffectChanged" Unchecked="EffectChanged"/>
                <CheckBox x:Name="LimiterBox" Content="Limiter" Tag="Limiter" Margin="0,0,20,10" Checked="EffectChanged" Unchecked="EffectChanged"/>
              </WrapPanel>
              <TextBlock x:Name="StatusLabel" Text="Выбери приложение и включи DSP рядом с его названием." Foreground="#68717D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>