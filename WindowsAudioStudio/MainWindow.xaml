<Window x:Class="WindowsAudioStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows Audio Studio" Height="900" Width="1500" MinHeight="700" MinWidth="1100" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="4,0,4,16">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="WINDOWS AUDIO STUDIO" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="DeviceLabel" Text="Подключение к аудиоустройству..." Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Обновить" Click="Refresh_Click"/><Button Content="Сбросить EQ" Click="ResetEq_Click"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="14" Margin="0,0,12,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top"><TextBlock Text="АКТИВНЫЕ ИСТОЧНИКИ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/><TextBlock Text="Громкость каждой аудиосессии Windows" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,12"/></StackPanel>
          <ListBox x:Name="SessionsList" ItemsSource="{Binding Sessions}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SessionsList_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate>
              <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="10" Margin="0,3">
                <StackPanel>
                  <DockPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VolumePercent, StringFormat={}{0}%}" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}"/></DockPanel>
                  <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"/>
                  <DockPanel><TextBlock Text="{Binding ProcessName}" FontSize="10" Foreground="{StaticResource TextMuted}"/><CheckBox Content="Mute" IsChecked="{Binding IsMuted}" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}"/></DockPanel>
                  <ProgressBar Height="4" Maximum="1" Value="{Binding Peak}" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel><StackPanel><TextBlock Text="20-BAND EQUALIZER" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="SelectedSessionLabel" Text="Глобальная панель настроек · EQ пока демонстрационный" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/></StackPanel>
                <ComboBox x:Name="PresetCombo" Width="170" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="PresetCombo_SelectionChanged"><ComboBoxItem Content="Flat"/><ComboBoxItem Content="Bass Boost"/><ComboBoxItem Content="Vocal"/><ComboBoxItem Content="Rock"/><ComboBoxItem Content="Electronic"/><ComboBoxItem Content="Custom"/></ComboBox>
              </DockPanel>
              <UniformGrid x:Name="EqGrid" Rows="1" Margin="0,24,0,0"/>
              <TextBlock Text="−12 dB                                      0 dB                                      +12 dB" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="ЗВУКОВЫЕ МОДУЛИ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,4,0,8"/>
          <UniformGrid Columns="3">
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,8,8"><StackPanel><CheckBox Content="Bass Boost"/><TextBlock Text="Усиление низких частот" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,8,8"><StackPanel><CheckBox Content="Surround"/><TextBlock Text="Пространственная обработка" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,8,8"><StackPanel><CheckBox Content="Stereo Width"/><TextBlock Text="Ширина стерео" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,8,8"><StackPanel><CheckBox Content="Reverb"/><TextBlock Text="Реверберация" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,8,8"><StackPanel><CheckBox Content="Compressor"/><TextBlock Text="Динамическая компрессия" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,8,8"><StackPanel><CheckBox Content="Limiter"/><TextBlock Text="Защита от перегрузки" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6"/></StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="Следующий этап: DSP-движок и маршрутизация обработанного сигнала." Foreground="{StaticResource TextMuted}" Margin="4,10,0,20" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>