<Application x:Class="WindowsAudioStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F3F5F7"/>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Panel2" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="Accent" Color="#377DCE"/>
    <SolidColorBrush x:Key="TextMain" Color="#20242A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#68717D"/>
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="BorderBrush" Value="#D4DAE2"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="{x:Type Slider}">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Margin" Value="2,5"/>
    </Style>
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
  </Application.Resources>
</Application>