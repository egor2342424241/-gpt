<Application x:Class="WindowsAudioStudio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#101522"/>
    <SolidColorBrush x:Key="Panel" Color="#192338"/>
    <SolidColorBrush x:Key="Panel2" Color="#202D46"/>
    <SolidColorBrush x:Key="Accent" Color="#69A9FF"/>
    <SolidColorBrush x:Key="TextMain" Color="#F1F5FF"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9EADC9"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="BorderBrush" Value="#344563"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Margin" Value="2,5"/></Style>
  </Application.Resources>
</Application>